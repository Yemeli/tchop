# ============================================================================
# TCHOP — modèle de variables pour `docker compose`.
# NE PAS REMPLIR À LA MAIN : lancez `./docker/genkeys.sh` qui génère
# `docker/.env` (et `.env` à la racine, nécessaire à l'interpolation compose).
# Ne commitez JAMAIS de vraies valeurs.
# ============================================================================

# Mot de passe postgres (rôles postgres, authenticator, supabase_*_admin)
POSTGRES_PASSWORD=

# Secret HS256 partagé : GoTrue, PostgREST, Realtime, Storage
JWT_SECRET=

# Clés API dérivées (JWT signés) — coller ANON_KEY dans l'écran
# Configuration de l'app (super-admin) avec l'URL http://<hôte>:8000
ANON_KEY=
SERVICE_ROLE_KEY=

# Realtime (Elixir) : base de 64 caractères min. + clé de chiffrement
SECRET_KEY_BASE=
REALTIME_DB_ENC_KEY=

# Durée de vie des JWT utilisateur (secondes)
JWT_EXPIRY=3600

# true = insère le restaurant + menu de DÉMO au premier démarrage.
# Mettez false pour une base vide.
SEED_DEMO=true
