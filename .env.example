# TCHOP — clés de build (.env.example)
#
# Ces valeurs sont les DEFAULTS de build (`--dart-define`). Elles restent
# le plan B : la méthode recommandée est de coller les clés à chaud dans
# l'app via l'écran super-admin **Configuration** (aucun rebuild requis,
# stockage chiffré sur l'appareil).
#
# Usage build-time :
#   flutter run \
#     --dart-define=SUPABASE_URL=https://xyzcompany.supabase.co \
#     --dart-define=SUPABASE_ANON_KEY=eyJhbGciOi... \
#     --dart-define=MAPS_API_KEY=AIza... \
#     --dart-define=MQTT_BROKER_URL=wss://broker.emqx.io:8084/mqtt
#
# NE JAMAIS commiter de vraies clés. Ce fichier reste un exemple.

# Backend Supabase — Supabase Dashboard → Project Settings → API
# (URL du projet + clé "anon" publique)
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# Google Maps — Google Cloud Console → APIs & Services → Credentials
# (clé API avec "Maps SDK for Android" et "Maps SDK for iOS" activés)
# NOTE : la carte native lit aussi la clé dans AndroidManifest.xml /
# AppDelegate au build — voir docs/configuration.md
MAPS_API_KEY=AIza...

# Broker MQTT (positions GPS des livreurs) — ex. EMQX Cloud → Deployment
# → Overview (adresse wss + port). Vide = mode SIMULATION.
MQTT_BROKER_URL=wss://broker.emqx.io:8084/mqtt

# Saveur d'app à lancer (customer | driver | kitchen | manager)
FLAVOR=customer
